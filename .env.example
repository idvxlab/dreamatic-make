# Dreamatic·Make system configuration.
# Copy to .env at the project root. Never commit real keys.
# Settings saved in the UI update the same .env file.
MAKE_CONFIG_REVISION=0
MAKE_PROVIDER_NAME="Custom provider"
MAKE_API_PROTOCOL="openai-completions"
MAKE_API_BASE_URL=""
MAKE_MODEL_ID=""
MAKE_CONTEXT_WINDOW=131072
MAKE_MAX_TOKENS=16384
MAKE_COMPACTION=true
MAKE_RETRY_ATTEMPTS=2
MAKE_LANGUAGE=zh
MAKE_THEME=light
MAKE_API_KEY=""
MAKE_SEARCH_PROVIDER=serper
SERPER_API_KEY=""
BRAVE_SEARCH_API_KEY=""

# Optional startup settings. Restart after changing these.
PORT=4311
HARNESS_DATA_DIR=.data
WORKSPACE_DIR=workspace

# Independent OpenAI Images compatible generation/editing service.
MAKE_IMAGE_PROTOCOL="openai-images"
MAKE_IMAGE_BASE_URL=""
MAKE_IMAGE_API_KEY=""
MAKE_IMAGE_MODEL=""
MAKE_IMAGE_EDIT_MODEL=""
MAKE_IMAGE_EDITING=false
MAKE_IMAGE_SIZE="1024x1024"
MAKE_IMAGE_QUALITY=""
MAKE_IMAGE_OUTPUT_FORMAT="provider-default"
MAKE_IMAGE_GENERATION_ENDPOINT=""
MAKE_IMAGE_EDIT_ENDPOINT=""
MAKE_IMAGE_TIMEOUT=300
MAKE_IMAGE_CONCURRENCY=2
